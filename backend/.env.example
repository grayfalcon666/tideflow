# Database
DSN=root:password@tcp(localhost:3306)/tideflow?charset=utf8mb4&parseTime=True&loc=Local

# Redis
REDIS_HOST=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Elasticsearch
ES_ADDRESSES=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=

# Kibana
KIBANA_URL=http://localhost:5601

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Server
SERVER_PORT=8080

# Upload
UPLOAD_DIR=./uploads

# Big V threshold
BIG_V_THRESHOLD=10000

# Rate limits
LOGIN_RATE_LIMIT=10/min
REGISTER_RATE_LIMIT=5/hour
LIKE_RATE_LIMIT=30/min
COMMENT_RATE_LIMIT=10/min
SOCIAL_RATE_LIMIT=20/min